<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/logo.png">
  <title><%= form.title %></title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #f0ebf8; /* Google Forms default background */
    }
    .title-font {
      font-family: 'Google Sans', sans-serif;
    }
    .input-border {
      border-bottom: 1px solid #d1d5db;
    }
    .input-border:focus {
      border-bottom: 2px solid #673ab7; /* Google Purple */
    }
  </style>
</head>
<body class="min-h-screen py-8 px-4 sm:px-6 flex flex-col items-center">
  
  <div class="w-full max-w-3xl space-y-3">
    
    <!-- Title Card -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="h-2.5 w-full bg-[#673ab7]"></div>
      <div class="p-6 sm:p-8">
        <h1 class="text-3xl font-medium text-gray-900 title-font tracking-tight"><%= form.title %></h1>
        <% if (form.description) { %>
          <p class="text-gray-600 mt-3 text-sm"><%= form.description %></p>
        <% } %>
        
        <% if (form.category === 'paid') { %>
          <div class="mt-4 inline-flex items-center gap-2 bg-yellow-50 text-yellow-800 px-3 py-1.5 rounded text-sm font-medium border border-yellow-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Registration Fee: ₹<%= form.price %>
          </div>
        <% } %>
        
        <div class="mt-6 pt-4 border-t border-gray-100 text-sm text-red-600 font-medium">
          * Indicates required question
        </div>
      </div>
    </div>

    <form method="POST" action="/forms/<%= form._id %>/submit" class="space-y-4">
      
      <!-- Email Field -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4 transition-all hover:shadow-md">
        <label class="block text-gray-800 text-base font-medium">
          Email Address <span class="text-red-600">*</span>
        </label>
        <input 
          type="email" 
          name="email"
          placeholder="Your email"
          class="w-full sm:w-1/2 bg-transparent text-gray-800 text-sm py-2 outline-none input-border transition-all"
          required 
        />
      </div>

      <!-- Mobile Field -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4 transition-all hover:shadow-md">
        <label class="block text-gray-800 text-base font-medium">
          Contact Number <span class="text-red-600">*</span>
        </label>
        <div class="flex items-end gap-2 w-full sm:w-1/2">
          <span class="text-gray-500 text-sm pb-2">+91</span>
          <input 
            type="tel" 
            name="mobileNumber"
            pattern="[0-9]{10}"
            maxlength="10"
            placeholder="Your answer"
            class="flex-1 bg-transparent text-gray-800 text-sm py-2 outline-none input-border transition-all"
            required 
          />
        </div>
      </div>

      <!-- Dynamic Fields -->
      <% form.fields.forEach(f => { %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4 transition-all hover:shadow-md focus-within:border-l-4 focus-within:border-l-[#673ab7]">
          <label class="block text-gray-800 text-base font-medium break-words">
            <%= f.label %> <% if (f.required) { %><span class="text-red-600">*</span><% } %>
          </label>
          
          <% if (f.type === 'textarea') { %>
            <textarea 
              name="<%= f.label %>" 
              placeholder="Your answer"
              rows="1"
              oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"
              class="w-full bg-transparent text-gray-800 text-sm py-2 outline-none input-border resize-none overflow-hidden transition-all"
              <%= f.required ? "required" : "" %>
            ></textarea>

          <% } else if (f.type === 'select') { %>
            <select 
              name="<%= f.label %>" 
              class="w-full sm:w-1/2 bg-transparent text-gray-800 text-sm py-2 outline-none input-border transition-all cursor-pointer"
              <%= f.required ? "required" : "" %>
            >
              <option value="" disabled selected hidden>Choose</option>
              <% if (f.options && f.options.length) { %>
                <% f.options.forEach(opt => { %>
                  <option value="<%= opt %>"><%= opt %></option>
                <% }) %>
              <% } %>
            </select>

          <% } else if (f.type === 'radio') { %>
            <div class="space-y-3 mt-3">
              <% if (f.options && f.options.length) { %>
                <% f.options.forEach((opt, idx) => { %>
                  <label class="flex items-center gap-3 cursor-pointer group">
                    <div class="relative flex items-center justify-center w-5 h-5">
                      <input 
                        type="radio" 
                        name="<%= f.label %>" 
                        value="<%= opt %>" 
                        class="peer appearance-none w-5 h-5 border-2 border-gray-400 rounded-full checked:border-[#673ab7] transition-all cursor-pointer"
                        <%= f.required ? "required" : "" %>
                      />
                      <div class="absolute w-2.5 h-2.5 bg-[#673ab7] rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                    </div>
                    <span class="text-gray-700 text-sm group-hover:text-gray-900 transition-colors"><%= opt %></span>
                  </label>
                <% }) %>
              <% } %>
            </div>

          <% } else if (f.type === 'checkbox') { %>
            <div class="space-y-3 mt-3">
              <% if (f.options && f.options.length) { %>
                <% f.options.forEach((opt, idx) => { %>
                  <label class="flex items-center gap-3 cursor-pointer group">
                    <input 
                      type="checkbox" 
                      name="<%= f.label %>" 
                      value="<%= opt %>" 
                      class="w-5 h-5 text-[#673ab7] border-gray-400 rounded focus:ring-[#673ab7] cursor-pointer"
                    />
                    <span class="text-gray-700 text-sm group-hover:text-gray-900 transition-colors"><%= opt %></span>
                  </label>
                <% }) %>
              <% } else { %>
                <label class="flex items-center gap-3 cursor-pointer group">
                  <input 
                    type="checkbox" 
                    name="<%= f.label %>" 
                    value="Yes" 
                    class="w-5 h-5 text-[#673ab7] border-gray-400 rounded focus:ring-[#673ab7] cursor-pointer"
                    <%= f.required ? "required" : "" %>
                  />
                  <span class="text-gray-700 text-sm group-hover:text-gray-900 transition-colors">Yes</span>
                </label>
              <% } %>
            </div>

          <% } else { %>
            <input 
              type="<%= f.type %>" 
              name="<%= f.label %>" 
              placeholder="Your answer"
              class="w-full sm:w-1/2 bg-transparent text-gray-800 text-sm py-2 outline-none input-border transition-all"
              <%= f.required ? "required" : "" %>
            />
          <% } %>
        </div>
      <% }) %>

      <!-- Submit Footer -->
      <div class="flex items-center justify-between pt-2 pb-8">
        <button type="submit" class="bg-[#673ab7] hover:bg-[#5e35b1] text-white font-medium px-6 py-2 rounded transition-colors text-sm">
          Submit
        </button>
        
        <div class="text-xs text-gray-500 font-medium">
          Garud Classes
        </div>
      </div>
    </form>
  </div>
</body>
</html>
