<div class="max-w-4xl mx-auto pb-24 relative flex flex-col lg:flex-row gap-6 items-start">
  <!-- Form Submission Wrapper -->
  <form id="editForm" class="w-full lg:flex-1 space-y-6">
    <input type="hidden" id="formId" value="<%= form._id %>" />

    <!-- Form Title & Header Card -->
    <div class="bg-white border-t-[10px] border-t-indigo-600 border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8 space-y-4 focus-within:border-l-4 focus-within:border-l-indigo-600 transition-all duration-200">
      <input type="text" id="title" placeholder="Untitled Form"
        class="w-full text-3xl font-extrabold text-slate-900 border-b border-transparent focus:border-slate-200 hover:border-slate-100 focus:border-b-2 py-2.5 outline-none tracking-tight transition" 
        value="<%= form.title %>" required />
      
      <textarea id="description" placeholder="Form description" rows="2"
        class="w-full text-sm text-slate-600 border-b border-transparent focus:border-slate-200 hover:border-slate-100 focus:border-b-2 py-1 outline-none resize-none transition"><%= form.description || '' %></textarea>
        
      <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-100">
        <div>
          <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Due Date</label>
          <input type="date" id="date" class="w-full border border-slate-200 rounded-xl p-2 text-sm outline-none font-semibold text-slate-700 bg-slate-50 focus:border-indigo-550 transition" 
            value="<%= form.date || '' %>" />
        </div>
        <div>
          <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Due Time</label>
          <input type="time" id="time" class="w-full border border-slate-200 rounded-xl p-2 text-sm outline-none font-semibold text-slate-700 bg-slate-50 focus:border-indigo-550 transition" 
            value="<%= form.time || '' %>" />
        </div>
      </div>
    </div>

    <!-- Alert / Notice Card -->
    <div class="p-4 bg-amber-50 border border-amber-200 rounded-2xl text-amber-900 text-xs font-semibold flex items-center gap-2.5">
      <i class="fas fa-info-circle text-amber-600 text-sm"></i>
      <span>Notice: <strong>Contact Number</strong> and <strong>Email Address</strong> are default fields generated on form fill. Do not add them manually!</span>
    </div>

    <!-- Questions Stack Container -->
    <div id="questionsContainer" class="space-y-6">
      <!-- Rendered by JavaScript -->
    </div>

    <!-- Form Active State Card -->
    <div class="flex items-center gap-3 bg-white border border-slate-200 p-5 rounded-2xl shadow-sm focus-within:border-l-4 focus-within:border-l-indigo-600 transition-all duration-200">
      <input type="checkbox" id="isActive" <%= form.isActive ? 'checked' : '' %> 
        class="w-4 h-4 rounded text-indigo-650 border-slate-350 focus:ring-indigo-500 transition cursor-pointer" />
      <label for="isActive" class="text-sm font-bold text-slate-700 cursor-pointer select-none">Accept Submissions (Form is Active)</label>
    </div>

  </form>

  <!-- Sticky Side Action Bar (Desktop only) -->
  <div class="sticky top-24 hidden lg:flex flex-col gap-3 bg-white border border-slate-200 p-2.5 rounded-2xl shadow-xl shrink-0">
    <button type="button" onclick="addQuestion()"
      class="w-12 h-12 flex items-center justify-center bg-indigo-600 text-white rounded-xl transition shadow-sm outline-none cursor-pointer" title="Add Question">
      <i class="fas fa-plus text-lg"></i>
    </button>
    <button type="submit" form="editForm"
      class="w-12 h-12 flex items-center justify-center bg-indigo-600 text-white rounded-xl transition shadow-sm outline-none cursor-pointer" title="Save Changes">
      <i class="fas fa-save text-lg"></i>
    </button>
    <a href="/forms/list"
      class="w-12 h-12 flex items-center justify-center bg-indigo-600 text-white rounded-xl transition shadow-sm outline-none cursor-pointer" title="Cancel">
      <i class="fas fa-times text-lg"></i>
    </a>
  </div>

  <!-- Mobile Floating Action Bar (Mobile only) -->
  <div class="fixed bottom-6 right-6 lg:hidden z-30 flex gap-3 bg-white border border-slate-200 p-2.5 rounded-2xl shadow-xl">
    <button type="button" onclick="addQuestion()"
      class="w-12 h-12 flex items-center justify-center bg-indigo-600 text-white rounded-xl transition shadow-sm outline-none cursor-pointer" title="Add Question">
      <i class="fas fa-plus text-lg"></i>
    </button>
    <button type="submit" form="editForm"
      class="w-12 h-12 flex items-center justify-center bg-indigo-600 text-white rounded-xl transition shadow-sm outline-none cursor-pointer" title="Save Changes">
      <i class="fas fa-save text-lg"></i>
    </button>
    <a href="/forms/list"
      class="w-12 h-12 flex items-center justify-center bg-indigo-600 text-white rounded-xl transition shadow-sm outline-none cursor-pointer" title="Cancel">
      <i class="fas fa-times text-lg"></i>
    </a>
  </div>
</div>

<script>
  // Load pre-existing fields
  const questions = <%- JSON.stringify(form.fields || []) %>;

  function renderQuestions() {
    const container = document.getElementById("questionsContainer");
    container.innerHTML = "";

    if (questions.length === 0) {
      container.innerHTML = `
        <div class="border-2 border-dashed border-slate-200 rounded-3xl p-12 text-center bg-slate-50/50">
          <p class="text-slate-400 font-semibold text-sm">No questions added yet. Click the "+" button in the floating panel to start.</p>
        </div>
      `;
      return;
    }

    questions.forEach((q, qIdx) => {
      let optionsHtml = '';
      const isChoiceType = q.type === 'select' || q.type === 'radio' || q.type === 'checkbox';

      if (isChoiceType) {
        let bulletIcon = '';
        if (q.type === 'radio') bulletIcon = '<i class="far fa-circle text-slate-450 mr-1.5 shrink-0"></i>';
        if (q.type === 'checkbox') bulletIcon = '<i class="far fa-square text-slate-455 mr-1.5 shrink-0"></i>';
        if (q.type === 'select') bulletIcon = `<span class="text-xs font-extrabold text-slate-400 mr-2 shrink-0">${q.options.length}.</span>`;

        q.options.forEach((opt, optIdx) => {
          optionsHtml += `
            <div class="flex items-center gap-3">
              ${bulletIcon}
              <input type="text" value="${escapeHtml(opt)}" oninput="updateOption(${qIdx}, ${optIdx}, this.value)"
                class="flex-1 border-b border-transparent hover:border-slate-200 focus:border-indigo-655 focus:border-b-2 py-1.5 text-sm outline-none font-semibold transition bg-transparent"
                placeholder="Option ${optIdx + 1}" required />
              ${q.options.length > 1 ? `
                <button type="button" onclick="removeOption(${qIdx}, ${optIdx})" class="text-slate-400 hover:text-rose-650 transition cursor-pointer p-1">
                  <i class="fas fa-times text-sm"></i>
                </button>
              ` : ''}
            </div>
          `;
        });

        // Add Option CTA
        optionsHtml += `
          <div class="flex items-center gap-3 pt-2">
            ${bulletIcon}
            <button type="button" onclick="addOption(${qIdx})" class="text-indigo-600 hover:text-indigo-800 text-xs font-bold transition cursor-pointer">
              + Add Option
            </button>
          </div>
        `;
      } else {
        // Render simple placeholder mock based on type
        let mockPlaceholder = 'Short answer text';
        if (q.type === 'textarea') mockPlaceholder = 'Long answer text';
        if (q.type === 'number') mockPlaceholder = 'Numeric input response';
        if (q.type === 'date') mockPlaceholder = 'Date input response';
        if (q.type === 'time') mockPlaceholder = 'Time input response';

        optionsHtml = `
          <div class="border-b border-slate-200 w-2/3 py-2 text-slate-400 text-sm italic select-none">
            ${mockPlaceholder}
          </div>
        `;
      }

      container.innerHTML += `
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-4 focus-within:border-l-4 focus-within:border-l-indigo-600 transition-all duration-200 flex flex-col">
          
          <!-- Top section: Question field input + Type selector -->
          <div class="flex flex-col md:flex-row gap-4 justify-between items-start md:items-center">
            <input type="text" value="${escapeHtml(q.label)}" oninput="updateQuestionLabel(${qIdx}, this.value)"
              placeholder="Question label"
              class="flex-1 text-base font-bold text-slate-800 border-b border-slate-200 hover:border-slate-350 focus:border-indigo-600 focus:border-b-2 py-2 outline-none transition bg-transparent" required />
              
            <select onchange="updateQuestionType(${qIdx}, this.value)" 
              class="border border-slate-250 rounded-xl p-2.5 text-sm outline-none font-semibold bg-white cursor-pointer w-48 shadow-sm">
              <option value="text" ${q.type === 'text' ? 'selected' : ''}>Short answer</option>
              <option value="textarea" ${q.type === 'textarea' ? 'selected' : ''}>Paragraph</option>
              <option value="select" ${q.type === 'select' ? 'selected' : ''}>Dropdown</option>
              <option value="radio" ${q.type === 'radio' ? 'selected' : ''}>Multiple choice</option>
              <option value="checkbox" ${q.type === 'checkbox' ? 'selected' : ''}>Checkboxes</option>
              <option value="number" ${q.type === 'number' ? 'selected' : ''}>Number</option>
              <option value="date" ${q.type === 'date' ? 'selected' : ''}>Date</option>
              <option value="time" ${q.type === 'time' ? 'selected' : ''}>Time</option>
            </select>
          </div>

          <!-- Middle section: dynamic option items or placeholder -->
          <div class="space-y-3 pt-2">
            ${optionsHtml}
          </div>

          <!-- Bottom Section: Required toggle + delete -->
          <div class="flex justify-end items-center gap-4 pt-4 border-t border-slate-100 text-slate-400 mt-2 select-none">
            <!-- Required Switch -->
            <div class="flex items-center gap-2 border-r border-slate-200 pr-4">
              <span class="text-xs font-extrabold text-slate-500">Required</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" class="sr-only peer" ${q.required ? 'checked' : ''} onchange="updateQuestionRequired(${qIdx}, this.checked)">
                <div class="w-8 h-4.5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-355 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-indigo-600"></div>
              </label>
            </div>

            <!-- Position Arrows -->
            <button type="button" onclick="moveQuestionUp(${qIdx})" ${qIdx === 0 ? 'disabled' : ''}
              class="p-2 hover:text-slate-700 disabled:opacity-30 disabled:pointer-events-none transition cursor-pointer" title="Move Up">
              <i class="fas fa-arrow-up text-sm"></i>
            </button>
            <button type="button" onclick="moveQuestionDown(${qIdx})" ${qIdx === questions.length - 1 ? 'disabled' : ''}
              class="p-2 hover:text-slate-700 disabled:opacity-30 disabled:pointer-events-none transition cursor-pointer" title="Move Down">
              <i class="fas fa-arrow-down text-sm"></i>
            </button>

            <!-- Delete Trash Icon -->
            <button type="button" onclick="removeQuestion(${qIdx})"
              class="p-2 text-slate-400 hover:text-rose-650 transition cursor-pointer animate-pulse" title="Delete Question">
              <i class="fas fa-trash-alt text-sm"></i>
            </button>
          </div>
        </div>
      `;
    });
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  function updateQuestionLabel(index, val) {
    questions[index].label = val;
  }

  function updateQuestionType(index, val) {
    questions[index].type = val;
    // Reset options array if choice type selected
    if (val === 'select' || val === 'radio' || val === 'checkbox') {
      if (!questions[index].options || questions[index].options.length === 0) {
        questions[index].options = ['Option 1'];
      }
    } else {
      questions[index].options = [];
    }
    renderQuestions();
  }

  function updateQuestionRequired(index, checked) {
    questions[index].required = checked;
  }

  function updateOption(qIdx, optIdx, val) {
    questions[qIdx].options[optIdx] = val;
  }

  function addOption(qIdx) {
    const nextIdx = questions[qIdx].options.length + 1;
    questions[qIdx].options.push(`Option ${nextIdx}`);
    renderQuestions();
  }

  function removeOption(qIdx, optIdx) {
    questions[qIdx].options.splice(optIdx, 1);
    renderQuestions();
  }

  function removeQuestion(index) {
    questions.splice(index, 1);
    renderQuestions();
  }

  function moveQuestionUp(index) {
    if (index === 0) return;
    const temp = questions[index];
    questions[index] = questions[index - 1];
    questions[index - 1] = temp;
    renderQuestions();
  }

  // Edit action reorder down
  function moveQuestionDown(index) {
    if (index === questions.length - 1) return;
    const temp = questions[index];
    questions[index] = questions[index + 1];
    questions[index + 1] = temp;
    renderQuestions();
  }

  function addQuestion() {
    questions.push({ label: '', type: 'text', required: true, options: [] });
    renderQuestions();
    
    // Smooth scroll to bottom
    setTimeout(() => {
      window.scrollTo({
        top: document.body.scrollHeight,
        behavior: 'smooth'
      });
    }, 50);
  }

  // Handle Form Submission
  document.getElementById("editForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const id = document.getElementById("formId").value;
    
    // Simple verification
    let valid = true;
    questions.forEach((q, idx) => {
      if (!q.label.trim()) {
        valid = false;
      }
      if ((q.type === "select" || q.type === "radio" || q.type === "checkbox") && (!q.options || q.options.length === 0)) {
        alert(`Options are required for Choice question at position ${idx + 1}`);
        valid = false;
      }
    });

    if (!valid) return;

    const data = {
      title: document.getElementById("title").value.trim(),
      description: document.getElementById("description").value.trim(),
      date: document.getElementById("date").value,
      time: document.getElementById("time").value,
      fields: questions,
      isActive: document.getElementById("isActive").checked
    };

    try {
      const res = await fetch(`/forms/edit/${id}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        if (typeof showToast === 'function') {
          showToast("Form updated successfully", "success");
        } else {
          alert("Form updated successfully");
        }
        window.location.href = "/forms/list";
      } else {
        alert(result.message || "Update failed");
      }
    } catch(err) {
      console.error(err);
      alert("Error updating form");
    }
  });

  // Initial draw
  renderQuestions();
</script>
