<div class="w-full px-6 py-8 space-y-6">

  <!-- Simplified Page Header -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-5 border-b border-slate-200">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
        <span>👥 User Accounts Directory</span>
      </h1>
    </div>

    <a href="/teachers/new" 
       class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl font-bold text-xs shadow-sm transition">
      <i class="fas fa-plus text-[10px]"></i> Add User Account
    </a>
  </div>

  <!-- Users Data Table Card -->
  <div class="bg-white border border-slate-100 rounded-3xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-650">
        <thead class="bg-slate-50 border-b border-slate-100 font-bold uppercase tracking-wider text-xs text-slate-700">
          <tr>
            <th class="py-4 px-6">Name / Details</th>
            <th class="py-4 px-6">Username</th>
            <th class="py-4 px-6">System Role</th>
            <th class="py-4 px-6 text-center">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% users.forEach(u => { %>
            <tr class="hover:bg-slate-50/50 transition">
              <td class="py-3.5 px-6">
                <div class="flex items-center gap-3">
                  <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.name) %>&background=random" 
                       class="w-9 h-9 rounded-full border border-slate-100 shadow-sm" alt="<%= u.name %>">
                  <div>
                    <p class="font-bold text-slate-850"><%= u.name %></p>
                  </div>
                </div>
              </td>
              <td class="py-3.5 px-6 font-semibold text-slate-700">
                <%= u.username %>
              </td>
              <td class="py-3.5 px-6">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-indigo-50 text-indigo-700 border border-indigo-150">
                  <%= u.role %>
                </span>
              </td>
              <td class="py-3.5 px-6">
                <div class="flex items-center justify-center gap-2">
                  <a href="/teachers/<%= u._id %>/edit"
                     class="inline-flex items-center gap-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 font-bold text-xs px-3 py-1.5 rounded-xl transition">
                     <i class="fas fa-edit text-[10px]"></i> Edit
                  </a>
                  <button type="button" onclick="requestDeleteUser('<%= u._id %>', '<%= u.name %>')" class="inline-flex items-center gap-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs px-3 py-1.5 rounded-xl transition">
                    <i class="fas fa-trash-alt text-[10px]"></i> Delete
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Delete User OTP Modal -->
<div id="deleteUserOtpModal" class="fixed inset-0 z-50 overflow-y-auto hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl border border-slate-100 max-w-md w-full shadow-2xl p-6 relative overflow-hidden transition-all duration-300">
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-rose-600"></div>
    
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-lg font-extrabold text-slate-900">Confirm Permanent Deletion</h3>
      <button onclick="closeDeleteUserModal()" class="text-slate-400 hover:text-slate-600 transition">
        <i class="fas fa-times text-lg"></i>
      </button>
    </div>

    <!-- OTP Input Form -->
    <form id="deleteUserOtpForm" onsubmit="confirmDeleteUser(event)" class="space-y-4">
      <input type="hidden" id="deleteUserId" />
      <div class="bg-slate-50 border border-slate-150 rounded-2xl p-4 text-center text-xs font-semibold text-slate-650">
        <p class="text-rose-700 font-bold"><i class="fas fa-exclamation-triangle"></i> Security Authorization Required</p>
        <p class="mt-1">A verification OTP has been sent to your administrator email.</p>
      </div>

      <div>
        <label class="block mb-1 text-xs font-bold text-slate-500 uppercase tracking-wider">Enter OTP Code *</label>
        <input 
          type="text" 
          id="deleteUserOtpInput"
          required 
          placeholder="6-digit OTP code"
          maxlength="6"
          class="w-full text-center tracking-widest border border-slate-200 focus:border-rose-500 focus:ring-4 focus:ring-rose-50 rounded-xl px-3.5 py-2.5 text-sm outline-none font-bold text-slate-805 transition" 
        />
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button type="button" onclick="closeDeleteUserModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2.5 rounded-xl transition">Cancel</button>
        <button type="submit" id="confirmDeleteUserBtn" class="bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition shadow-sm">Confirm Deletion</button>
      </div>
    </form>
  </div>
</div>

<script>
  let currentDeleteUserId = null;

  async function requestDeleteUser(userId, userName) {
    if (!confirm(`Are you sure you want to permanently delete the user account for "${userName}"? This action cannot be undone.`)) {
      return;
    }
    
    if (typeof showToast === 'function') {
      showToast("Sending OTP to your administrator email...", "info");
    }
    
    try {
      const response = await fetch(`/teachers/${userId}/delete-request`, {
        method: 'POST'
      });
      const result = await response.json();
      
      if (result.success) {
        currentDeleteUserId = userId;
        document.getElementById('deleteUserId').value = userId;
        document.getElementById('deleteUserOtpInput').value = '';
        document.getElementById('deleteUserOtpModal').classList.remove('hidden');
        if (typeof showToast === 'function') {
          showToast(result.message, "success");
        }
      } else {
        if (typeof showToast === 'function') {
          showToast(result.message || 'Failed to request OTP', "error");
        } else {
          alert('Error: ' + result.message);
        }
      }
    } catch (error) {
      if (typeof showToast === 'function') {
        showToast('Failed to send OTP. Please try again.', "error");
      } else {
        alert('Failed to send OTP. Please try again.');
      }
    }
  }

  function closeDeleteUserModal() {
    document.getElementById('deleteUserOtpModal').classList.add('hidden');
  }

  async function confirmDeleteUser(event) {
    event.preventDefault();
    const otp = document.getElementById('deleteUserOtpInput').value;
    const confirmBtn = document.getElementById('confirmDeleteUserBtn');
    
    confirmBtn.disabled = true;
    confirmBtn.innerText = 'Verifying...';
    
    try {
      const response = await fetch(`/teachers/${currentDeleteUserId}/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ otp })
      });
      const result = await response.json();
      
      if (result.success) {
        if (typeof showToast === 'function') {
          showToast(result.message, "success");
        }
        closeDeleteUserModal();
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } else {
        if (typeof showToast === 'function') {
          showToast(result.message || 'Invalid OTP', "error");
        } else {
          alert('Error: ' + result.message);
        }
        confirmBtn.disabled = false;
        confirmBtn.innerText = 'Confirm Deletion';
      }
    } catch (error) {
      if (typeof showToast === 'function') {
        showToast('Failed to verify OTP. Please try again.', "error");
      } else {
        alert('Failed to verify OTP. Please try again.');
      }
      confirmBtn.disabled = false;
      confirmBtn.innerText = 'Confirm Deletion';
    }
  }
</script>
