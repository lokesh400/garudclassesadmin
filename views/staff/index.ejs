<div class="w-full px-6 py-8 space-y-6">

  <!-- Flash messages -->
  <%- include('../flash.ejs') %>

  <!-- Top Dashboard Banner -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 bg-white border border-slate-100 p-6 rounded-3xl shadow-sm">
    <div>
      <div class="flex items-center gap-2 text-sm text-slate-500 font-medium mb-1">
        <a href="/admin" class="hover:text-indigo-650 transition">Dashboard</a>
        <span>&bull;</span>
        <span class="text-slate-805 font-bold">Staff Directory</span>
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
        <span>👥 Staff Records</span>
      </h1>
      <p class="text-slate-500 text-sm mt-1">Manage employee details, roles, credentials, documents, and active status.</p>
    </div>

    <a href="/admin/staff/new" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold text-xs transition shadow-md shadow-indigo-600/10">
      <i class="fas fa-plus text-[10px]"></i> Add Staff Member
    </a>
  </div>

  <!-- Search / Meta Controls -->
  <div class="bg-white border border-slate-100 rounded-3xl p-5 shadow-sm flex flex-col md:flex-row gap-4 items-center justify-between">
    <div class="relative w-full md:max-w-md">
      <span class="absolute left-4 top-3 text-slate-400 text-xs">
        <i class="fas fa-search"></i>
      </span>
      <input id="staffSearchInput" type="text" placeholder="Search staff by name or department..." 
             class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 rounded-2xl text-xs outline-none font-semibold text-slate-700 transition" />
    </div>

    <p id="staffSearchMeta" class="text-slate-500 font-bold text-xs"></p>
  </div>

  <!-- Table Container -->
  <div class="bg-white border border-slate-100 rounded-3xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-700">
        <thead class="bg-slate-50 text-slate-800 border-b border-slate-100 font-bold uppercase tracking-wider text-xs">
          <tr>
            <th class="py-4 px-6">Name</th>
            <th class="py-4 px-6">Username</th>
            <th class="py-4 px-6">Contact Number</th>
            <th class="py-4 px-6">Department</th>
            <th class="py-4 px-6">Designation</th>
            <th class="py-4 px-6 text-center">Status</th>
            <th class="py-4 px-6 text-center">Actions</th>
          </tr>
        </thead>
        <tbody id="staffTableBody" class="divide-y divide-slate-100">
          <% if (!staff.length) { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-slate-500 font-bold text-xs italic">No staff records found.</td>
            </tr>
          <% } %>

          <% staff.forEach((s) => { %>
            <tr class="hover:bg-slate-50/50 staff-row transition" 
                data-staff-name="<%= (s.name || '').toLowerCase().replace(/"/g, '&quot;') %>"
                data-staff-dept="<%= (s.department || '').toLowerCase().replace(/"/g, '&quot;') %>">
              <td class="py-3.5 px-6">
                <div class="flex items-center gap-3">
                  <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(s.name) %>&background=random" 
                       class="w-8 h-8 rounded-full border border-slate-100" alt="<%= s.name %>">
                  <span class="font-bold text-slate-850"><%= s.name || '-' %></span>
                </div>
              </td>
              <td class="py-3.5 px-6 font-semibold text-slate-650"><%= s.username || '-' %></td>
              <td class="py-3.5 px-6 font-bold text-slate-700"><%= s.mobileNumber || s.phone || '-' %></td>
              <td class="py-3.5 px-6">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                  <%= s.department || '-' %>
                </span>
              </td>
              <td class="py-3.5 px-6 font-bold text-slate-750"><%= s.designation || '-' %></td>
              <td class="py-3.5 px-6 text-center">
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold border <%= s.status === 'Active' ? 'bg-emerald-50 text-emerald-700 border-emerald-150' : 'bg-slate-100 text-slate-600 border-slate-200' %>">
                  <%= s.status %>
                </span>
              </td>
              <td class="py-3.5 px-6">
                <div class="flex gap-2 items-center justify-center">
                  <a href="/admin/staff/<%= s._id %>" class="inline-flex items-center gap-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-705 font-bold text-[10px] px-2.5 py-1.5 rounded-xl border border-indigo-150 transition">
                    View Details
                  </a>
                  <button type="button" onclick="requestToggleStatus('<%= s._id %>', '<%= s.name %>')" class="inline-flex items-center rounded-xl px-2.5 py-1.5 text-[10px] font-bold border transition <%= s.status === 'Active' ? 'bg-rose-50 hover:bg-rose-100 text-rose-700 border-rose-150' : 'bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border-emerald-150' %>">
                    <%= s.status === 'Active' ? 'Deactivate' : 'Activate' %>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (function() {
    const searchInput = document.getElementById("staffSearchInput");
    const tableBody = document.getElementById("staffTableBody");
    const searchMeta = document.getElementById("staffSearchMeta");

    const staffRows = tableBody ? Array.from(tableBody.querySelectorAll(".staff-row")) : [];
    const totalRows = staffRows.length;

    const renderSearchMeta = (visibleCount, query) => {
      if (!searchMeta) return;
      if (!query) {
        searchMeta.textContent = `Showing all ${totalRows} staff records`;
        return;
      }
      searchMeta.textContent = `Showing ${visibleCount} of ${totalRows} records matching "${query}"`;
    };

    const filterStaff = () => {
      if (!searchInput || !tableBody) return;
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      staffRows.forEach((row) => {
        const name = row.dataset.staffName || "";
        const dept = row.dataset.staffDept || "";
        const matched = !query || name.includes(query) || dept.includes(query);
        row.classList.toggle("hidden", !matched);
        if (matched) visibleCount += 1;
      });

      renderSearchMeta(visibleCount, query);
    };

    if (searchInput) {
      searchInput.addEventListener("input", filterStaff);
      renderSearchMeta(totalRows, "");
    }
  })();

  let currentToggleStaffId = null;

  async function requestToggleStatus(staffId, staffName) {
    if (typeof showToast === 'function') {
      showToast("Sending OTP to your administrator email...", "info");
    }
    
    try {
      const response = await fetch(`/admin/staff/${staffId}/toggle-status-request`, {
        method: 'POST'
      });
      const result = await response.json();
      
      if (result.success) {
        currentToggleStaffId = staffId;
        document.getElementById('toggleStatusStaffId').value = staffId;
        document.getElementById('toggleStatusOtpInput').value = '';
        document.getElementById('toggleStatusOtpModal').classList.remove('hidden');
        if (typeof showToast === 'function') {
          showToast(result.message, "success");
        }
      } else {
        if (typeof showToast === 'function') {
          showToast(result.message || 'Failed to request OTP', "error");
        } else {
          alert('Error: ' + result.message);
        }
      }
    } catch (error) {
      if (typeof showToast === 'function') {
        showToast('Failed to send OTP. Please try again.', "error");
      } else {
        alert('Failed to send OTP. Please try again.');
      }
    }
  }

  function closeToggleStatusModal() {
    document.getElementById('toggleStatusOtpModal').classList.add('hidden');
  }

  async function confirmToggleStatus(event) {
    event.preventDefault();
    const otp = document.getElementById('toggleStatusOtpInput').value;
    const confirmBtn = document.getElementById('confirmToggleStatusBtn');
    
    confirmBtn.disabled = true;
    confirmBtn.innerText = 'Verifying...';
    
    try {
      const response = await fetch(`/admin/staff/${currentToggleStaffId}/toggle-status-confirm`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ otp })
      });
      const result = await response.json();
      
      if (result.success) {
        if (typeof showToast === 'function') {
          showToast(result.message, "success");
        }
        closeToggleStatusModal();
        // Refresh page after a brief delay
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } else {
        if (typeof showToast === 'function') {
          showToast(result.message || 'Invalid OTP', "error");
        } else {
          alert('Error: ' + result.message);
        }
        confirmBtn.disabled = false;
        confirmBtn.innerText = 'Confirm Status Change';
      }
    } catch (error) {
      if (typeof showToast === 'function') {
        showToast('Failed to verify OTP. Please try again.', "error");
      } else {
        alert('Failed to verify OTP. Please try again.');
      }
      confirmBtn.disabled = false;
      confirmBtn.innerText = 'Confirm Status Change';
    }
  }
</script>

<!-- Toggle Status OTP Modal -->
<div id="toggleStatusOtpModal" class="fixed inset-0 z-50 overflow-y-auto hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl border border-slate-100 max-w-md w-full shadow-2xl p-6 relative overflow-hidden transition-all duration-300">
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-indigo-600"></div>
    
    <div class="flex justify-between items-center mb-6">
      <h3 class="text-lg font-extrabold text-slate-900">Security Verification Required</h3>
      <button onclick="closeToggleStatusModal()" class="text-slate-400 hover:text-slate-600 transition">
        <i class="fas fa-times text-lg"></i>
      </button>
    </div>

    <!-- OTP Input Form -->
    <form id="toggleStatusOtpForm" onsubmit="confirmToggleStatus(event)" class="space-y-4">
      <input type="hidden" id="toggleStatusStaffId" />
      <div class="bg-slate-50 border border-slate-150 rounded-2xl p-4 text-center text-xs font-semibold text-slate-650">
        <p class="text-indigo-700 font-bold"><i class="fas fa-check-circle"></i> Verification OTP has been sent!</p>
        <p class="mt-1">Please check your registered administrator email inbox.</p>
      </div>

      <div>
        <label class="block mb-1 text-xs font-bold text-slate-500 uppercase tracking-wider">Enter OTP Code *</label>
        <input 
          type="text" 
          id="toggleStatusOtpInput"
          required 
          placeholder="6-digit OTP code"
          maxlength="6"
          class="w-full text-center tracking-widest border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-50 rounded-xl px-3.5 py-2.5 text-sm outline-none font-bold text-slate-805 transition" 
        />
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button type="button" onclick="closeToggleStatusModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-4 py-2.5 rounded-xl transition">Cancel</button>
        <button type="submit" id="confirmToggleStatusBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition shadow-sm">Confirm Status Change</button>
      </div>
    </form>
  </div>
</div>
